# JWT Secret for backend authentication
# Replace with a secure key in production
JWT_SECRET=YourSuperSecretKeyForJwtAuthenticationWhichMustBeLongEnough123!

# JWT expiration in milliseconds (default: 30 minutes)
JWT_EXPIRATION=1800000

# Frontend API base URL (/api works with Vite proxy or Docker nginx)
VITE_API_BASE_URL=/api
