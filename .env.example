# MedVault environment — copy to .env and fill in real values (never commit .env).
# Generate a secret with: openssl rand -hex 32  (minimum 32 characters)

# JWT (REQUIRED — backend fails fast at startup when missing)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# JWT expiration in milliseconds (default: 30 minutes)
JWT_EXPIRATION=1800000

# CORS Allowed Origins (comma-separated; REQUIRED in prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (dev/docker defaults shown; REQUIRED in prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medvault
SPRING_DATASOURCE_USERNAME=medvault_user
SPRING_DATASOURCE_PASSWORD=medvault_password

# Backend listening port
PORT=8080

# Trust X-Forwarded-For for login rate limiting ONLY behind a trusted proxy
RATE_LIMIT_TRUST_PROXY=false

# Frontend API base URL (/api works with Vite proxy or Docker nginx)
VITE_API_BASE_URL=/api
